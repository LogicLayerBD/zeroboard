# Server
PORT=3000
HOST=0.0.0.0

# Security
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Database
DATABASE_URL=sqlite://data/zeroboard.db
# Set to true for builds without a live database
# Set to false when running cargo sqlx prepare
SQLX_OFFLINE=false

# Storage
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=25

# App
APP_NAME=ZeroBoard
FIRST_USER_IS_ADMIN=true
# false = only admins create accounts (Admin → Users); the first account can always register
REGISTRATION_ENABLED=true
